# Copy to .env.local. Never commit a real one — .env* is gitignored.

# --- Database ---------------------------------------------------------
# Any Postgres. Free options: neon.tech, supabase.com.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# --- Auth -------------------------------------------------------------
# Generate with:  npx auth secret
AUTH_SECRET=
# Base URL of the app. Vercel sets this automatically in production.
NEXTAUTH_URL=http://localhost:3000

# --- Model provider ---------------------------------------------------
# Pick one. If both are set, LLM_PROVIDER decides.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# LLM_PROVIDER=gemini

# Embeddings for memory retrieval (§13). Uses the Gemini key above.
EMBEDDING_MODEL=gemini-embedding-001

# --- Limits (§52, §53) -------------------------------------------------
# MESSAGES_PER_HOUR_FREE=60
# MESSAGES_PER_HOUR_PLUS=300
# MAX_INPUT_CHARS=120000
# UPSTREAM_TIMEOUT_MS=60000

# --- Proactive texts (optional) ------------------------------------------
# Web push keys, generated once:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Authenticates whatever calls POST /api/proactive/run (a cron service).
# CRON_SECRET=

# Prisma migrations go over the direct (non-pooled) connection.
# DATABASE_URL_UNPOOLED=
